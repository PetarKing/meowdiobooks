{
  "name": "meowdiobooks-workflow-ui",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/test",
    "!src/main.tsx"
  ],
  "exports": {
    ".": "./src/App.tsx",
    "./api": "./src/api/client.ts",
    "./contracts": "./src/api/contracts.ts",
    "./i18n": "./src/i18n.ts",
    "./workflow": "./src/workflow/navigation.ts",
    "./styles.css": "./src/styles.css",
    "./media.css": "./src/media.css",
    "./product.css": "./src/styles/product.css",
    "./ui": "./src/ui.ts",
    "./agent-guide": "./src/agent-guide.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --config vitest.storybook.config.ts",
    "storybook:check": "tsc -p stories/tsconfig.json",
    "visual:parity": "node scripts/visual-parity.mjs",
    "visual:review": "node scripts/visual-review.mjs",
    "test:consumer": "node scripts/verify-host-consumer.mjs",
    "studio": "vite --mode studio --host 127.0.0.1 --port 5179 --open /studio.html"
  },
  "dependencies": {
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.4.1",
    "i18next": "^26.3.6",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-i18next": "^17.0.9",
    "three": "0.186.1",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "eslint": "9.27.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.1.0",
    "jsdom": "26.1.0",
    "picomatch": "4.0.5",
    "pixelmatch": "^7.1.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "storybook": "10.6.3",
    "typescript-eslint": "8.32.1",
    "vitest": "4.1.12"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
